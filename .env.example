# ============================================================
# SRM Credit Engine — Environment Variables
# Copie para .env e ajuste antes de subir:  cp .env.example .env
# ============================================================

# ---- PostgreSQL ----
POSTGRES_DB=srm_credit_engine
POSTGRES_USER=srm_user
POSTGRES_PASSWORD=srm_pass_2026

# ---- JWT (Auth) ----
# Base64 de uma chave com no mínimo 32 bytes. Troque em produção!
JWT_SECRET=c2VjdXJlLWRldi1zZWNyZXQtY2hhbmdlLW1lLWluLXByb2R1Y3Rpb24tMjAyNi1zcm0tc3Jt
JWT_ISSUER=srm-credit-engine
JWT_EXPIRATION_MINUTES=480

# ---- Kafka (Confluent) ----
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Observabilidade ----
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
GRAFANA_ADMIN_PASSWORD=admin

# ---- Seed de usuários (criados no startup do auth-service) ----
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_OPERATOR_USERNAME=operator
SEED_OPERATOR_PASSWORD=Operator@123
SEED_MANAGER_USERNAME=manager
SEED_MANAGER_PASSWORD=Manager@123
